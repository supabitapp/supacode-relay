[Unit]
Description=Supacode push HTTPS ingress
After=network-online.target supacode-push.service
Wants=network-online.target supacode-push.service

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 run --token-file %d/tunnel.token
LoadCredential=tunnel.token:/etc/supacode-push/tunnel.token
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=5
TimeoutStopSec=20
MemoryMax=256M

[Install]
WantedBy=multi-user.target
