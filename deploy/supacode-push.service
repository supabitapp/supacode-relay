[Unit]
Description=Supacode APNs gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supacode-push
EnvironmentFile=/etc/supacode-push/push.env
Environment=PUSH_ADDR=127.0.0.1:18771
Environment=PUSH_DATABASE=/var/lib/supacode-push/push.sqlite
Environment=APNS_SANDBOX_KEY_FILE=%d/apns-sandbox.p8
Environment=APNS_PRODUCTION_KEY_FILE=%d/apns-production.p8
LoadCredential=apns-sandbox.p8:/etc/supacode-push/apns-sandbox.p8
LoadCredential=apns-production.p8:/etc/supacode-push/apns-production.p8
StateDirectory=supacode-push
StateDirectoryMode=0700
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=2
TimeoutStopSec=20
MemoryMax=256M

[Install]
WantedBy=multi-user.target
