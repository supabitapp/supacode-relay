[Unit]
Description=Supacode WebSocket relay node
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supacode-relay
Environment=RELAY_ADDR=127.0.0.1:8080
Environment=RELAY_PRIVATE_ADDR=127.0.0.1:9090
Environment=RELAY_TRUSTED_PROXIES=127.0.0.1/32
Environment=RELAY_CLIENT_IP_HEADER=X-Relay-Client-Ip
Environment=RELAY_ROUTERS=https://relay-directory.int.exe.xyz
Environment=RELAY_DIRECTORY_TOKEN_FILE=%d/directory-token
Environment=RELAY_MAX_HOSTS=8000
Environment=RELAY_MAX_CLIENTS=8000
Environment=RELAY_MAX_QUEUE_BYTES=65536
Environment=GOMEMLIMIT=2GiB
EnvironmentFile=/etc/supacode-relay/node.env
LoadCredential=directory-token:/etc/supacode-relay/directory-token
Restart=always
RestartSec=2
TimeoutStopSec=15
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=3G

[Install]
WantedBy=multi-user.target
