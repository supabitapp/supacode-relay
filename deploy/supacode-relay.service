[Unit]
Description=Supacode WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supacode-relay
Environment=RELAY_ADDR=127.0.0.1:8080
Environment=RELAY_TRUSTED_PROXIES=127.0.0.1/32
Restart=always
RestartSec=2
TimeoutStopSec=10
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
