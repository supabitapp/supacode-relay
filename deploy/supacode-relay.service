[Unit]
Description=Supacode WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/supacode-relay
Environment=RELAY_ADDR=127.0.0.1:8080
Environment=RELAY_PRIVATE_ADDR=127.0.0.1:9090
Environment=RELAY_PRIVATE_ALLOWED_PEERS=127.0.0.1/32
Environment=RELAY_TRUSTED_PROXIES=127.0.0.1/32
Environment=RELAY_MAX_HOSTS=8000
Environment=RELAY_MAX_CLIENTS=8000
Environment=RELAY_MAX_QUEUE_BYTES=65536
Environment=RELAY_MAX_CONNS=10000
Environment=RELAY_MAX_CONNS_PER_IP=1500
Environment=GOMEMLIMIT=2GiB
Restart=always
RestartSec=2
TimeoutStopSec=15
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=131072
MemoryMax=3G

[Install]
WantedBy=multi-user.target
