{
  "name": "supaterm-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "check": "tsc --noEmit && prettier --check src scripts package.json tsconfig.json",
    "format": "prettier --write src scripts package.json tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
